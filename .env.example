# Copy to ".env.local" and fill in. Supabase values: dashboard → Settings → API.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended ---
# Your public site URL (share links + Open Graph).
NEXT_PUBLIC_SITE_URL=
# Launch date (YYYY-MM-DD). Puzzle No.1 lands on this day. Default 2026-01-01.
NEXT_PUBLIC_LAUNCH_DATE=
# Reset timezone as minutes east of UTC (controls when the daily puzzle flips AND
# the countdown). 330 = IST (midnight in India), 0 = UTC, -300 = US Eastern.
NEXT_PUBLIC_TZ_OFFSET_MINUTES=330

# --- Question generator (optional) ---
# Secret that protects /admin and /api/admin/generate. Set it to enable the generator.
ADMIN_KEY=
# Provide ONE of these to have the generator invent brand-new questions with AI.
# If neither is set, the generator falls back to a built-in bank of extra questions.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Ads (optional, leave blank until AdSense is approved) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
